# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# URL Web App Google Apps Script MASTER REGISTRY (Pusat Pengembang Multi-Tenant)
# Masukkan URL Web App (/exec) dari Spreadsheet Master pengembang di Vercel Environment Variables.
# Dengan ini, seluruh madrasah yang mengakses web langsung terhubung ke sistem verifikasi kode unik & PIN.
VITE_MASTER_REGISTRY_URL=""

# URL Web App Google Apps Script Spreadsheet Madrasah Default (Opsional)
# Jika dikosongkan, madrasah akan otomatis diarahkan berdasarkan Kode Unik saat aktivasi di aplikasi.
VITE_APPS_SCRIPT_URL=""
